<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <CheckBox
        android:id="@+id/cbKontinenti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dobavi kontinente" />

    <CheckBox
        android:id="@+id/cbTreciKontinent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prikaži broj država trećeg kontinenta" />

    <ImageButton
        android:id="@+id/btnKamera"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Kamera" />

    <TextView
        android:id="@+id/tvSenzor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proximity:"
        android:textSize="18sp"
        android:paddingTop="16dp" />

    <TextView
        android:id="@+id/tvRezultat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rezultat:"
        android:textSize="18sp"
        android:paddingTop="16dp" />

</LinearLayout>